# Translation model: Hugging Face ID, or local LoRA adapter / merged checkpoint
TRANSLATION_MODEL_ID=Qwen/Qwen3-0.6B
# After fine-tuning:
# TRANSLATION_MODEL_ID=checkpoints/qwen3-fa-en-lora

# Device: auto | cuda | cpu
DEVICE=auto

# Generation limits
MAX_INPUT_LENGTH=1024
MAX_NEW_TOKENS=512
TRANSLATION_TEMPERATURE=0.3
TRANSLATION_TOP_P=0.8
TRANSLATION_TOP_K=20

# OmniVoice TTS
OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
OMNIVOICE_NUM_STEP=32
OMNIVOICE_SPEED=1.0
OMNIVOICE_VOICE_INSTRUCT=female, young adult, moderate pitch

# Audio output directory (relative or absolute)
OUTPUT_DIR=outputs
MAX_CACHED_AUDIO_FILES=20
